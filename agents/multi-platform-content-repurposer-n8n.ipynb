   "source": [
    "# Performance analytics and monitoring\n",
    "print(\"📊 PERFORMANCE ANALYTICS DASHBOARD\")\n",
    "print(\"=\" * 35)\n",
    "\n",
    "# Get performance metrics\n",
    "metrics = repurposer.get_performance_metrics()\n",
    "\n",
    "if metrics['metrics']:\n",
    "    print(f\"\\n📈 PERFORMANCE SUMMARY:\")\n",
    "    summary = metrics['summary']\n",
    "    print(f\"  • Total Posts: {summary['total_posts']}\")\n",
    "    print(f\"  • Average Engagement Rate: {summary['avg_engagement_rate']:.2%}\")\n",
    "    print(f\"  • Total Reach: {summary['total_reach']:,}\")\n",
    "    \n",
    "    print(f\"\\n🔍 PLATFORM BREAKDOWN:\")\n",
    "    platform_stats = {}\n",
    "    for metric in metrics['metrics']:\n",
    "        platform = metric['platform']\n",
    "        if platform not in platform_stats:\n",
    "            platform_stats[platform] = {\n",
    "                'posts': 0,\n",
    "                'total_engagement': 0,\n",
    "                'total_reach': 0,\n",
    "                'total_clicks': 0,\n",
    "                'total_shares': 0,\n",
    "                'total_comments': 0\n",
    "            }\n",
    "        \n",
    "        stats = platform_stats[platform]\n",
    "        stats['posts'] += 1\n",
    "        stats['total_engagement'] += metric['engagement_rate']\n",
    "        stats['total_reach'] += metric['reach']\n",
    "        stats['total_clicks'] += metric['clicks']\n",
    "        stats['total_shares'] += metric['shares']\n",
    "        stats['total_comments'] += metric['comments']\n",
    "    \n",
    "    for platform, stats in platform_stats.items():\n",
    "        avg_engagement = stats['total_engagement'] / stats['posts']\n",
    "        print(f\"\\n  📱 {platform.upper()}:\")\n",
    "        print(f\"    • Posts: {stats['posts']}\")\n",
    "        print(f\"    • Avg Engagement: {avg_engagement:.2%}\")\n",
    "        print(f\"    • Total Reach: {stats['total_reach']:,}\")\n",
    "        print(f\"    • Total Clicks: {stats['total_clicks']:,}\")\n",
    "        print(f\"    • Total Shares: {stats['total_shares']:,}\")\n",
    "        print(f\"    • Total Comments: {stats['total_comments']:,}\")\n",
    "    \n",
    "    # Performance insights\n",
    "    best_platform = max(platform_stats.items(), key=lambda x: x[1]['total_engagement'] / x[1]['posts'])\n",
    "    print(f\"\\n🏆 PERFORMANCE INSIGHTS:\")\n",
    "    print(f\"  • Best Performing Platform: {best_platform[0].capitalize()}\")\n",
    "    print(f\"  • Best Engagement Rate: {(best_platform[1]['total_engagement'] / best_platform[1]['posts']):.2%}\")\n",
    "    \n",
    "    # Optimization recommendations\n",
    "    print(f\"\\n💡 OPTIMIZATION RECOMMENDATIONS:\")\n",
    "    \n",
    "    # Find low-performing platforms\n",
    "    avg_engagement_overall = summary['avg_engagement_rate']\n",
    "    for platform, stats in platform_stats.items():\n",
    "        platform_avg = stats['total_engagement'] / stats['posts']\n",
    "        if platform_avg < avg_engagement_overall * 0.8:\n",
    "            print(f\"  • Improve {platform} content strategy - below average engagement\")\n",
    "        elif platform_avg > avg_engagement_overall * 1.2:\n",
    "            print(f\"  • Scale {platform} content - high engagement potential\")\n",
    "    \n",
    "    print(f\"  • Consider A/B testing different content formats\")\n",
    "    print(f\"  • Analyze posting times for better engagement\")\n",
    "    print(f\"  • Monitor trending hashtags and topics\")\n",
    "    \n",
    "else:\n",
    "    print(\"📊 No performance metrics available yet.\")\n",
    "\n",
    "print(\"\\n✅ Performance analytics complete!\")"
   ]

   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Platform-Specific Content Adaptation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class PlatformAdapter:\n",
    "    def __init__(self):\n",
    "        self.openai_client = openai_client\n",
    "        self.anthropic_client = anthropic_client if ANTHROPIC_AVAILABLE else None\n",
    "    \n",
    "    def adapt_content(self, original_content: str, target_platform: Platform, \n",
    "                     content_analysis: Dict[str, Any]) -> ContentPiece:\n",
    "        \"\"\"Adapt content for a specific platform.\"\"\"\n",
    "        platform_config = PLATFORM_CONFIGS[target_platform]\n",
    "        \n",
    "        # Generate platform-specific content\n",
    "        adapted_content = self._generate_platform_content(\n",
    "            original_content, platform_config, content_analysis\n",
    "        )\n",
    "        \n",
    "        # Generate hashtags\n",
    "        hashtags = self._generate_hashtags(\n",
    "            adapted_content, platform_config, content_analysis\n",
    "        )\n",
    "        \n",
    "        # Create content piece\n",
    "        content_piece = ContentPiece(\n",
    "            title=self._extract_title(adapted_content),\n",
    "            body=adapted_content,\n",
    "            media_urls=[],\n",
    "            hashtags=hashtags,\n",
    "            platform=target_platform,\n",
    "            scheduled_time=self._suggest_posting_time(platform_config),\n",
    "            engagement_score=content_analysis.get('platform_suitability', {}).get(target_platform.value, 5)\n",
    "        )\n",
    "        \n",
    "        return content_piece\n",
    "    \n",
    "    def _generate_platform_content(self, original_content: str, platform_config: PlatformConfig, \n",
    "                                 analysis: Dict[str, Any]) -> str:\n",
    "        \"\"\"Generate content optimized for specific platform.\"\"\"\n",
    "        try:\n",
    "            adaptation_prompt = f\"\"\"\n",
    "            Adapt this content for {platform_config.name}:\n",
    "            \n",
    "            Original Content: {original_content}\n",
    "            \n",
    "            Platform Requirements:\n",
    "            - Max length: {platform_config.max_text_length} characters\n",
    "            - Tone: {platform_config.preferred_tone}\n",
    "            - Target audience: {analysis.get('target_audience', 'general')}\n",
    "            - Content type: {analysis.get('content_type', 'post')}\n",
    "            \n",
    "            Adaptation Guidelines:\n",
    "            - Maintain core message and value\n",
    "            - Adjust tone to match platform expectations\n",
    "            - Optimize for engagement on this platform\n",
    "            - Include call-to-action appropriate for platform\n",
    "            - Stay within character limits\n",
    "            \n",
    "            Return only the adapted content, no explanations.\n",
    "            \"\"\"\n",
    "            \n",
    "            response = self.openai_client.chat.completions.create(\n",
    "                model=\"gpt-4\",\n",
    "                messages=[\n",
    "                    {\"role\": \"system\", \"content\": f\"You are a social media expert specializing in {platform_config.name} content optimization. Create engaging, platform-native content.\"},\n",
    "                    {\"role\": \"user\", \"content\": adaptation_prompt}\n",
    "                ],\n",
    "                temperature=0.7\n",
    "            )\n",
    "            \n",
    "            adapted_content = response.choices[0].message.content.strip()\n",
    "            \n",
    "            # Ensure content fits within platform limits\n",
    "            if len(adapted_content) > platform_config.max_text_length:\n",
    "                adapted_content = adapted_content[:platform_config.max_text_length - 3] + \"...\"\n",
    "            \n",
    "            return adapted_content\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Content adaptation error: {e}\")\n",
    "            # Fallback: simple truncation\n",
    "            return original_content[:platform_config.max_text_length]\n",
    "    \n",
    "    def _generate_hashtags(self, content: str, platform_config: PlatformConfig, \n",
    "                          analysis: Dict[str, Any]) -> List[str]:\n",
    "        \"\"\"Generate platform-appropriate hashtags.\"\"\"\n",
    "        try:\n",
    "            hashtag_prompt = f\"\"\"\n",
    "            Generate {platform_config.max_hashtags} hashtags for this {platform_config.name} post:\n",
    "            \n",
    "            Content: {content}\n",
    "            Topic: {analysis.get('topic_category', 'general')}\n",
    "            \n",
    "            Guidelines:\n",
    "            - Use trending and relevant hashtags\n",
    "            - Mix popular and niche hashtags\n",
    "            - Avoid overly generic hashtags\n",
    "            - Consider platform-specific hashtag culture\n",
    "            \n",
    "            Return hashtags separated by commas, with # prefix.\n",
    "            \"\"\"\n",
    "            \n",
    "            response = self.openai_client.chat.completions.create(\n",
    "                model=\"gpt-3.5-turbo\",\n",
    "                messages=[\n",
    "                    {\"role\": \"system\", \"content\": f\"You are a hashtag specialist for {platform_config.name}. Generate effective, trending hashtags.\"},\n",
    "                    {\"role\": \"user\", \"content\": hashtag_prompt}\n",
    "                ],\n",
    "                temperature=0.8\n",
    "            )\n",
    "            \n",
    "            hashtags_text = response.choices[0].message.content.strip()\n",
    "            hashtags = [tag.strip() for tag in hashtags_text.split(',')]\n",
    "            \n",
    "            # Ensure hashtags start with #\n",
    "            hashtags = [tag if tag.startswith('#') else f'#{tag}' for tag in hashtags]\n",
    "            \n",
    "            return hashtags[:platform_config.max_hashtags]\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Hashtag generation error: {e}\")\n",
    "            # Fallback hashtags\n",
    "            fallback_hashtags = analysis.get('hashtag_suggestions', ['#content', '#social'])\n",
    "            return fallback_hashtags[:platform_config.max_hashtags]\n",
    "    \n",
    "    def _extract_title(self, content: str) -> str:\n",
    "        \"\"\"Extract or generate a title from content.\"\"\"\n",
    "        # Take first line or first 60 characters as title\n",
    "        lines = content.split('\\n')\n",
    "        if lines:\n",
    "            title = lines[0].strip()\n",
    "            if len(title) > 60:\n",
    "                title = title[:57] + \"...\"\n",
    "            return title\n",
    "        return \"Content Post\"\n",
    "    \n",
    "    def _suggest_posting_time(self, platform_config: PlatformConfig) -> datetime:\n",
    "        \"\"\"Suggest optimal posting time based on platform.\"\"\"\n",
    "        import random\n",
    "        \n",
    "        # Get tomorrow's date\n",
    "        tomorrow = datetime.now() + timedelta(days=1)\n",
    "        \n",
    "        # Pick random optimal time\n",
    "        optimal_time = random.choice(platform_config.best_posting_times)\n",
    "        hour, minute = map(int, optimal_time.split(':'))\n",
    "        \n",
    "        return tomorrow.replace(hour=hour, minute=minute, second=0, microsecond=0)\n",
    "\n",
    "# Initialize platform adapter\n",
    "platform_adapter = PlatformAdapter()\n",
    "print(\"✅ Platform adapter ready!\")"
   ]
  },

    "        max_text_length=3000,\n",
    "        supports_images=True,\n",
    "        supports_videos=True,\n",
    "        max_hashtags=5,\n",
    "        preferred_tone=\"professional, informative\",\n",
    "        image_specs={\"width\": 1200, \"height\": 627, \"format\": \"PNG\"},\n",
    "        video_specs={\"max_duration\": 600, \"format\": \"MP4\"},\n",
    "        posting_frequency=\"1-2 times per day\",\n",
    "        best_posting_times=[\"08:00\", \"12:00\", \"17:00\"]\n",
    "    ),\n",
    "    Platform.INSTAGRAM: PlatformConfig(\n",
    "        name=\"Instagram\",\n",
    "        max_text_length=2200,\n",
    "        supports_images=True,\n",
    "        supports_videos=True,\n",
    "        max_hashtags=30,\n",
    "        preferred_tone=\"visual, engaging, lifestyle\",\n",
    "        image_specs={\"width\": 1080, \"height\": 1080, \"format\": \"JPG\"},\n",
    "        video_specs={\"max_duration\": 60, \"format\": \"MP4\"},\n",
    "        posting_frequency=\"1-3 times per day\",\n",
    "        best_posting_times=[\"11:00\", \"14:00\", \"17:00\"]\n",

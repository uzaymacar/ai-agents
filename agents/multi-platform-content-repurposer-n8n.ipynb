   "source": [
    "## Content Analysis and Intelligence System"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class ContentAnalyzer:\n",
    "    def __init__(self):\n",
    "        self.openai_client = openai_client\n",
    "        self.anthropic_client = anthropic_client if ANTHROPIC_AVAILABLE else None\n",
    "    \n",
    "    def analyze_content(self, content: str, media_urls: List[str] = None) -> Dict[str, Any]:\n",
    "        \"\"\"Analyze content for repurposing opportunities.\"\"\"\n",
    "        try:\n",
    "            analysis_prompt = f\"\"\"\n",
    "            Analyze this content for multi-platform repurposing:\n",
    "            \n",
    "            Content: {content}\n",
    "            Media URLs: {media_urls or 'None'}\n",
    "            \n",
    "            Provide analysis in JSON format:\n",
    "            {{\n",
    "                \"content_type\": \"article|video|image|podcast|tweet|post\",\n",
    "                \"topic_category\": \"technology|business|lifestyle|education|entertainment|news\",\n",
    "                \"target_audience\": \"professionals|general|students|entrepreneurs|creators\",\n",
    "                \"tone\": \"formal|casual|humorous|serious|inspirational\",\n",
    "                \"key_points\": [\"point1\", \"point2\", \"point3\"],\n",
    "                \"hashtag_suggestions\": [\"#tag1\", \"#tag2\", \"#tag3\"],\n",
    "                \"engagement_potential\": \"high|medium|low\",\n",
    "                \"platform_suitability\": {{\n",
    "                    \"twitter\": \"score_0_to_10\",\n",
    "                    \"linkedin\": \"score_0_to_10\",\n",
    "                    \"instagram\": \"score_0_to_10\",\n",
    "                    \"tiktok\": \"score_0_to_10\",\n",
    "                    \"youtube\": \"score_0_to_10\",\n",
    "                    \"facebook\": \"score_0_to_10\"\n",
    "                }},\n",
    "                \"repurposing_suggestions\": [\"suggestion1\", \"suggestion2\", \"suggestion3\"]\n",
    "            }}\n",
    "            \"\"\"\n",
    "            \n",
    "            response = self.openai_client.chat.completions.create(\n",
    "                model=\"gpt-4\",\n",
    "                messages=[\n",
    "                    {\"role\": \"system\", \"content\": \"You are a content marketing expert specializing in multi-platform content strategy. Provide detailed, actionable analysis.\"},\n",
    "                    {\"role\": \"user\", \"content\": analysis_prompt}\n",
    "                ],\n",
    "                temperature=0.3\n",
    "            )\n",
    "            \n",
    "            analysis_text = response.choices[0].message.content\n",
    "            \n",
    "            # Extract JSON from response\n",
    "            json_match = re.search(r'\\{.*\\}', analysis_text, re.DOTALL)\n",
    "            if json_match:\n",
    "                return json.loads(json_match.group())\n",
    "            else:\n",
    "                return self._create_default_analysis(content)\n",
    "                \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Content analysis error: {e}\")\n",
    "            return self._create_default_analysis(content)\n",
    "    \n",
    "    def _create_default_analysis(self, content: str) -> Dict[str, Any]:\n",
    "        \"\"\"Create default analysis when AI analysis fails.\"\"\"\n",
    "        return {\n",
    "            \"content_type\": \"post\",\n",
    "            \"topic_category\": \"general\",\n",
    "            \"target_audience\": \"general\",\n",
    "            \"tone\": \"casual\",\n",
    "            \"key_points\": [\"Main content point\"],\n",
    "            \"hashtag_suggestions\": [\"#content\", \"#social\", \"#share\"],\n",
    "            \"engagement_potential\": \"medium\",\n",
    "            \"platform_suitability\": {\n",
    "                \"twitter\": 7,\n",
    "                \"linkedin\": 6,\n",
    "                \"instagram\": 5,\n",
    "                \"tiktok\": 4,\n",
    "                \"youtube\": 3,\n",
    "                \"facebook\": 6\n",
    "            },\n",
    "            \"repurposing_suggestions\": [\"Create visual quote\", \"Make video summary\", \"Extract key insights\"]\n",
    "        }\n",
    "    \n",
    "    def extract_key_insights(self, content: str, count: int = 5) -> List[str]:\n",
    "        \"\"\"Extract key insights from content.\"\"\"\n",
    "        try:\n",
    "            prompt = f\"\"\"\n",
    "            Extract the {count} most important insights from this content:\n",
    "            \n",
    "            {content}\n",
    "            \n",
    "            Return as a simple list of insights, one per line.\n",
    "            \"\"\"\n",
    "            \n",
    "            response = self.openai_client.chat.completions.create(\n",
    "                model=\"gpt-3.5-turbo\",\n",
    "                messages=[\n",
    "                    {\"role\": \"system\", \"content\": \"You are an expert at extracting key insights from content. Be concise and actionable.\"},\n",
    "                    {\"role\": \"user\", \"content\": prompt}\n",
    "                ],\n",
    "                temperature=0.3\n",
    "            )\n",
    "            \n",
    "            insights = response.choices[0].message.content.strip().split('\\n')\n",
    "            return [insight.strip('- ').strip() for insight in insights if insight.strip()]\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Insight extraction error: {e}\")\n",
    "            return [\"Key insight from content\"]\n",
    "\n",
    "# Initialize content analyzer\n",
    "content_analyzer = ContentAnalyzer()\n",
    "print(\"✅ Content analyzer ready!\")"
   ]
  },

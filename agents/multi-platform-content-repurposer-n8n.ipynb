    "## n8n Workflow Integration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class N8nWorkflowManager:\n",
    "    def __init__(self, n8n_url: str = \"http://localhost:5678\"):\n",
    "        self.n8n_url = n8n_url\n",
    "        self.workflows = {}\n",
    "    \n",
    "    def create_content_repurposing_workflow(self) -> Dict[str, Any]:\n",
    "        \"\"\"Create n8n workflow for content repurposing.\"\"\"\n",
    "        workflow = {\n",
    "            \"name\": \"Multi-Platform Content Repurposer\",\n",
    "            \"nodes\": [\n",
    "                {\n",
    "                    \"id\": \"webhook\",\n",
    "                    \"name\": \"Content Webhook\",\n",
    "                    \"type\": \"n8n-nodes-base.webhook\",\n",
    "                    \"parameters\": {\n",
    "                        \"httpMethod\": \"POST\",\n",
    "                        \"path\": \"content-repurpose\",\n",
    "                        \"responseMode\": \"responseNode\"\n",
    "                    },\n",
    "                    \"position\": [250, 300]\n",
    "                },\n",
    "                {\n",
    "                    \"id\": \"analyze_content\",\n",
    "                    \"name\": \"Analyze Content\",\n",
    "                    \"type\": \"n8n-nodes-base.httpRequest\",\n",
    "                    \"parameters\": {\n",
    "                        \"method\": \"POST\",\n",
    "                        \"url\": \"http://localhost:8000/analyze\",\n",
    "                        \"jsonParameters\": True,\n",
    "                        \"body\": {\n",
    "                            \"content\": \"={{ $json.content }}\",\n",
    "                            \"media_urls\": \"={{ $json.media_urls }}\"\n",
    "                        }\n",
    "                    },\n",
    "                    \"position\": [450, 300]\n",
    "                },\n",
    "                {\n",
    "                    \"id\": \"split_platforms\",\n",
    "                    \"name\": \"Split by Platforms\",\n",
    "                    \"type\": \"n8n-nodes-base.splitInBatches\",\n",
    "                    \"parameters\": {\n",
    "                        \"batchSize\": 1,\n",
    "                        \"options\": {\n",
    "                            \"reset\": False\n",
    "                        }\n",
    "                    },\n",
    "                    \"position\": [650, 300]\n",
    "                },\n",
    "                {\n",
    "                    \"id\": \"adapt_content\",\n",
    "                    \"name\": \"Adapt Content\",\n",
    "                    \"type\": \"n8n-nodes-base.httpRequest\",\n",
    "                    \"parameters\": {\n",
    "                        \"method\": \"POST\",\n",
    "                        \"url\": \"http://localhost:8000/adapt\",\n",
    "                        \"jsonParameters\": True,\n",
    "                        \"body\": {\n",
    "                            \"content\": \"={{ $json.content }}\",\n",
    "                            \"platform\": \"={{ $json.platform }}\",\n",
    "                            \"analysis\": \"={{ $json.analysis }}\"\n",
    "                        }\n",
    "                    },\n",
    "                    \"position\": [850, 300]\n",
    "                },\n",
    "                {\n",
    "                    \"id\": \"schedule_post\",\n",
    "                    \"name\": \"Schedule Post\",\n",
    "                    \"type\": \"n8n-nodes-base.httpRequest\",\n",
    "                    \"parameters\": {\n",
    "                        \"method\": \"POST\",\n",
    "                        \"url\": \"http://localhost:8000/schedule\",\n",
    "                        \"jsonParameters\": True,\n",
    "                        \"body\": {\n",
    "                            \"content\": \"={{ $json.adapted_content }}\",\n",
    "                            \"platform\": \"={{ $json.platform }}\",\n",
    "                            \"scheduled_time\": \"={{ $json.scheduled_time }}\"\n",
    "                        }\n",
    "                    },\n",
    "                    \"position\": [1050, 300]\n",
    "                },\n",
    "                {\n",
    "                    \"id\": \"response\",\n",
    "                    \"name\": \"Response\",\n",
    "                    \"type\": \"n8n-nodes-base.respondToWebhook\",\n",
    "                    \"parameters\": {\n",
    "                        \"respondWith\": \"json\",\n",
    "                        \"responseBody\": \"={{ { status: 'success', message: 'Content repurposed successfully' } }}\"\n",
    "                    },\n",
    "                    \"position\": [1250, 300]\n",
    "                }\n",
    "            ],\n",
    "            \"connections\": {\n",
    "                \"webhook\": {\n",
    "                    \"main\": [[{\"node\": \"analyze_content\", \"type\": \"main\", \"index\": 0}]]\n",
    "                },\n",
    "                \"analyze_content\": {\n",
    "                    \"main\": [[{\"node\": \"split_platforms\", \"type\": \"main\", \"index\": 0}]]\n",
    "                },\n",
    "                \"split_platforms\": {\n",
    "                    \"main\": [[{\"node\": \"adapt_content\", \"type\": \"main\", \"index\": 0}]]\n",
    "                },\n",
    "                \"adapt_content\": {\n",
    "                    \"main\": [[{\"node\": \"schedule_post\", \"type\": \"main\", \"index\": 0}]]\n",
    "                },\n",
    "                \"schedule_post\": {\n",
    "                    \"main\": [[{\"node\": \"response\", \"type\": \"main\", \"index\": 0}]]\n",
    "                }\n",
    "            }\n",
    "        }\n",
    "        \n",
    "        return workflow\n",
    "    \n",
    "    def create_monitoring_workflow(self) -> Dict[str, Any]:\n",
    "        \"\"\"Create workflow for monitoring content performance.\"\"\"\n",
    "        workflow = {\n",
    "            \"name\": \"Content Performance Monitor\",\n",
    "            \"nodes\": [\n",
    "                {\n",
    "                    \"id\": \"cron_trigger\",\n",
    "                    \"name\": \"Hourly Check\",\n",
    "                    \"type\": \"n8n-nodes-base.cron\",\n",
    "                    \"parameters\": {\n",
    "                        \"triggerTimes\": {\n",
    "                            \"hour\": \"*\",\n",
    "                            \"minute\": \"0\"\n",
    "                        }\n",
    "                    },\n",
    "                    \"position\": [250, 300]\n",
    "                },\n",
    "                {\n",
    "                    \"id\": \"fetch_metrics\",\n",
    "                    \"name\": \"Fetch Metrics\",\n",
    "                    \"type\": \"n8n-nodes-base.httpRequest\",\n",
    "                    \"parameters\": {\n",
    "                        \"method\": \"GET\",\n",
    "                        \"url\": \"http://localhost:8000/metrics\"\n",
    "                    },\n",
    "                    \"position\": [450, 300]\n",
    "                },\n",
    "                {\n",
    "                    \"id\": \"analyze_performance\",\n",
    "                    \"name\": \"Analyze Performance\",\n",
    "                    \"type\": \"n8n-nodes-base.function\",\n",
    "                    \"parameters\": {\n",
    "                        \"functionCode\": \"\"\"\n",
    "                        const metrics = items[0].json.metrics;\n",
    "                        const analysis = {\n",
    "                            high_performers: metrics.filter(m => m.engagement_rate > 0.05),\n",
    "                            low_performers: metrics.filter(m => m.engagement_rate < 0.01),\n",
    "                            avg_engagement: metrics.reduce((a, b) => a + b.engagement_rate, 0) / metrics.length\n",
    "                        };\n",
    "                        return [{ json: analysis }];\n",
    "                        \"\"\"\n",
    "                    },\n",
    "                    \"position\": [650, 300]\n",
    "                },\n",
    "                {\n",
    "                    \"id\": \"send_report\",\n",
    "                    \"name\": \"Send Report\",\n",
    "                    \"type\": \"n8n-nodes-base.slack\",\n",
    "                    \"parameters\": {\n",
    "                        \"channel\": \"#content-analytics\",\n",
    "                        \"text\": \"📊 Content Performance Report: Average engagement: {{ $json.avg_engagement }}%\"\n",
    "                    },\n",
    "                    \"position\": [850, 300]\n",
    "                }\n",
    "            ],\n",
    "            \"connections\": {\n",
    "                \"cron_trigger\": {\n",
    "                    \"main\": [[{\"node\": \"fetch_metrics\", \"type\": \"main\", \"index\": 0}]]\n",
    "                },\n",
    "                \"fetch_metrics\": {\n",
    "                    \"main\": [[{\"node\": \"analyze_performance\", \"type\": \"main\", \"index\": 0}]]\n",
    "                },\n",
    "                \"analyze_performance\": {\n",
    "                    \"main\": [[{\"node\": \"send_report\", \"type\": \"main\", \"index\": 0}]]\n",
    "                }\n",
    "            }\n",
    "        }\n",
    "        \n",
    "        return workflow\n",
    "    \n",
    "    def deploy_workflow(self, workflow: Dict[str, Any]) -> bool:\n",
    "        \"\"\"Deploy workflow to n8n instance.\"\"\"\n",
    "        try:\n",
    "            # This would typically POST to n8n API\n",
    "            # For demo, we'll just store it locally\n",
    "            self.workflows[workflow['name']] = workflow\n",
    "            print(f\"✅ Workflow '{workflow['name']}' deployed successfully\")\n",
    "            return True\n",
    "        except Exception as e:\n",
    "            print(f\"❌ Workflow deployment failed: {e}\")\n",
    "            return False\n",
    "    \n",
    "    def trigger_workflow(self, workflow_name: str, data: Dict[str, Any]) -> Dict[str, Any]:\n",
    "        \"\"\"Trigger a workflow with data.\"\"\"\n",
    "        try:\n",
    "            # Simulate workflow execution\n",
    "            print(f\"🔄 Triggering workflow: {workflow_name}\")\n",
    "            print(f\"📤 Input data: {json.dumps(data, indent=2)}\")\n",
    "            \n",
    "            # Simulate processing\n",
    "            import time\n",
    "            time.sleep(0.5)\n",
    "            \n",
    "            return {\n",
    "                \"status\": \"success\",\n",
    "                \"workflow\": workflow_name,\n",
    "                \"execution_id\": f\"exec_{int(time.time())}\",\n",
    "                \"message\": \"Workflow executed successfully\"\n",
    "            }\n",
    "        except Exception as e:\n",
    "            return {\n",
    "                \"status\": \"error\",\n",
    "                \"error\": str(e)\n",
    "            }\n",
    "\n",
    "# Initialize n8n workflow manager\n",
    "n8n_manager = N8nWorkflowManager()\n",
    "print(\"✅ n8n workflow manager ready!\")"
   ]
  },

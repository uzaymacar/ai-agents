   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Multi-Platform Content Repurposer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class MultiPlatformContentRepurposer:\n",
    "    def __init__(self):\n",
    "        self.content_analyzer = content_analyzer\n",
    "        self.platform_adapter = platform_adapter\n",
    "        self.n8n_manager = n8n_manager\n",
    "        self.scheduled_content = []\n",
    "        self.performance_metrics = []\n",
    "    \n",
    "    def repurpose_content(self, original_content: str, target_platforms: List[Platform], \n",
    "                         media_urls: List[str] = None) -> Dict[str, Any]:\n",
    "        \"\"\"Repurpose content for multiple platforms.\"\"\"\n",
    "        try:\n",
    "            print(f\"🔄 Repurposing content for {len(target_platforms)} platforms...\")\n",
    "            \n",
    "            # Step 1: Analyze content\n",
    "            content_analysis = self.content_analyzer.analyze_content(original_content, media_urls)\n",
    "            print(f\"📊 Content analysis complete: {content_analysis.get('content_type', 'unknown')} type\")\n",
    "            \n",
    "            # Step 2: Adapt for each platform\n",
    "            adapted_content = []\n",
    "            for platform in target_platforms:\n",
    "                print(f\"🔧 Adapting for {platform.value}...\")\n",
    "                \n",
    "                content_piece = self.platform_adapter.adapt_content(\n",
    "                    original_content, platform, content_analysis\n",
    "                )\n",
    "                adapted_content.append(content_piece)\n",
    "                \n",
    "                # Schedule content\n",
    "                self.scheduled_content.append(content_piece)\n",
    "            \n",
    "            # Step 3: Generate repurposing report\n",
    "            report = self._generate_repurposing_report(original_content, adapted_content, content_analysis)\n",
    "            \n",
    "            return {\n",
    "                'status': 'success',\n",
    "                'original_content': original_content,\n",
    "                'content_analysis': content_analysis,\n",
    "                'adapted_content': adapted_content,\n",
    "                'report': report,\n",
    "                'timestamp': datetime.now().isoformat()\n",
    "            }\n",
    "            \n",
    "        except Exception as e:\n",
    "            return {\n",
    "                'status': 'error',\n",
    "                'error': str(e),\n",
    "                'timestamp': datetime.now().isoformat()\n",
    "            }\n",
    "    \n",
    "    def _generate_repurposing_report(self, original_content: str, adapted_content: List[ContentPiece], \n",
    "                                   content_analysis: Dict[str, Any]) -> Dict[str, Any]:\n",
    "        \"\"\"Generate comprehensive repurposing report.\"\"\"\n",
    "        report = {\n",
    "            'content_summary': {\n",
    "                'original_length': len(original_content),\n",
    "                'content_type': content_analysis.get('content_type', 'unknown'),\n",
    "                'topic_category': content_analysis.get('topic_category', 'general'),\n",
    "                'engagement_potential': content_analysis.get('engagement_potential', 'medium')\n",
    "            },\n",
    "            'platform_adaptations': [],\n",
    "            'scheduling_plan': [],\n",
    "            'performance_predictions': {},\n",
    "            'recommendations': []\n",
    "        }\n",
    "        \n",
    "        for content_piece in adapted_content:\n",
    "            platform_name = content_piece.platform.value\n",
    "            platform_config = PLATFORM_CONFIGS[content_piece.platform]\n",
    "            \n",
    "            # Platform adaptation details\n",
    "            adaptation_info = {\n",
    "                'platform': platform_name,\n",
    "                'adapted_length': len(content_piece.body),\n",
    "                'character_usage': f\"{len(content_piece.body)}/{platform_config.max_text_length}\",\n",
    "                'hashtags_count': len(content_piece.hashtags),\n",
    "                'tone_adjustment': platform_config.preferred_tone,\n",
    "                'engagement_score': content_piece.engagement_score\n",
    "            }\n",
    "            report['platform_adaptations'].append(adaptation_info)\n",
    "            \n",
    "            # Scheduling plan\n",
    "            if content_piece.scheduled_time:\n",
    "                schedule_info = {\n",
    "                    'platform': platform_name,\n",
    "                    'scheduled_time': content_piece.scheduled_time.isoformat(),\n",
    "                    'optimal_time': True,\n",
    "                    'posting_frequency': platform_config.posting_frequency\n",
    "                }\n",
    "                report['scheduling_plan'].append(schedule_info)\n",
    "            \n",
    "            # Performance prediction\n",
    "            predicted_engagement = self._predict_engagement(content_piece, content_analysis)\n",
    "            report['performance_predictions'][platform_name] = predicted_engagement\n",
    "        \n",
    "        # Generate recommendations\n",
    "        report['recommendations'] = self._generate_recommendations(adapted_content, content_analysis)\n",
    "        \n",
    "        return report\n",
    "    \n",
    "    def _predict_engagement(self, content_piece: ContentPiece, analysis: Dict[str, Any]) -> Dict[str, Any]:\n",
    "        \"\"\"Predict engagement metrics for content piece.\"\"\"\n",
    "        base_score = content_piece.engagement_score or 5\n",
    "        platform_config = PLATFORM_CONFIGS[content_piece.platform]\n",
    "        \n",
    "        # Calculate predicted metrics\n",
    "        engagement_rate = (base_score / 10) * 0.05  # 0-5% engagement rate\n",
    "        \n",
    "        # Adjust based on content factors\n",
    "        if analysis.get('engagement_potential') == 'high':\n",
    "            engagement_rate *= 1.5\n",
    "        elif analysis.get('engagement_potential') == 'low':\n",
    "            engagement_rate *= 0.7\n",
    "        \n",
    "        # Adjust based on hashtags\n",
    "        if len(content_piece.hashtags) > 0:\n",
    "            engagement_rate *= 1.2\n",
    "        \n",
    "        return {\n",
    "            'predicted_engagement_rate': round(engagement_rate, 4),\n",
    "            'estimated_reach': int(1000 * (base_score / 10)),\n",
    "            'confidence': 'medium',\n",
    "            'factors': {\n",
    "                'content_quality': base_score,\n",
    "                'platform_fit': base_score,\n",
    "                'hashtag_optimization': len(content_piece.hashtags) > 0,\n",
    "                'posting_time': content_piece.scheduled_time is not None\n",
    "            }\n",
    "        }\n",
    "    \n",
    "    def _generate_recommendations(self, adapted_content: List[ContentPiece], \n",
    "                                analysis: Dict[str, Any]) -> List[str]:\n",
    "        \"\"\"Generate optimization recommendations.\"\"\"\n",
    "        recommendations = []\n",
    "        \n",
    "        # Platform-specific recommendations\n",
    "        for content_piece in adapted_content:\n",
    "            platform_name = content_piece.platform.value\n",
    "            \n",
    "            if content_piece.engagement_score and content_piece.engagement_score < 6:\n",
    "                recommendations.append(f\"Consider revising {platform_name} content for better platform fit\")\n",
    "            \n",
    "            if len(content_piece.hashtags) < 3 and content_piece.platform != Platform.TWITTER:\n",
    "                recommendations.append(f\"Add more relevant hashtags for {platform_name}\")\n",
    "        \n",
    "        # Content-specific recommendations\n",
    "        if analysis.get('engagement_potential') == 'low':\n",
    "            recommendations.append(\"Consider adding more engaging elements like questions or call-to-actions\")\n",
    "        \n",
    "        # General recommendations\n",
    "        recommendations.extend([\n",
    "            \"Monitor performance metrics after posting\",\n",
    "            \"Adjust posting times based on audience engagement patterns\",\n",
    "            \"Consider creating visual content to improve engagement\"\n",
    "        ])\n",
    "        \n",
    "        return recommendations\n",
    "    \n",
    "    def schedule_content(self, content_pieces: List[ContentPiece]) -> Dict[str, Any]:\n",
    "        \"\"\"Schedule content for posting.\"\"\"\n",
    "        scheduled_posts = []\n",
    "        \n",
    "        for content_piece in content_pieces:\n",
    "            scheduled_post = {\n",
    "                'id': f\"post_{int(datetime.now().timestamp())}_{content_piece.platform.value}\",\n",
    "                'platform': content_piece.platform.value,\n",
    "                'content': content_piece.body,\n",
    "                'hashtags': content_piece.hashtags,\n",
    "                'scheduled_time': content_piece.scheduled_time.isoformat() if content_piece.scheduled_time else None,\n",
    "                'status': 'scheduled'\n",
    "            }\n",
    "            scheduled_posts.append(scheduled_post)\n",
    "        \n",
    "        return {\n",
    "            'scheduled_posts': scheduled_posts,\n",
    "            'total_posts': len(scheduled_posts),\n",
    "            'status': 'success'\n",
    "        }\n",
    "    \n",
    "    def get_performance_metrics(self) -> Dict[str, Any]:\n",
    "        \"\"\"Get performance metrics for all content.\"\"\"\n",
    "        # Simulate performance metrics\n",
    "        import random\n",
    "        \n",
    "        metrics = []\n",
    "        for content_piece in self.scheduled_content:\n",
    "            metric = {\n",
    "                'platform': content_piece.platform.value,\n",
    "                'engagement_rate': random.uniform(0.01, 0.08),\n",
    "                'reach': random.randint(500, 5000),\n",
    "                'clicks': random.randint(10, 200),\n",
    "                'shares': random.randint(5, 50),\n",
    "                'comments': random.randint(2, 30),\n",
    "                'timestamp': datetime.now().isoformat()\n",
    "            }\n",
    "            metrics.append(metric)\n",
    "        \n",
    "        return {\n",
    "            'metrics': metrics,\n",
    "            'summary': {\n",
    "                'total_posts': len(metrics),\n",
    "                'avg_engagement_rate': sum(m['engagement_rate'] for m in metrics) / len(metrics) if metrics else 0,\n",
    "                'total_reach': sum(m['reach'] for m in metrics)\n",
    "            }\n",
    "        }\n",
    "\n",
    "# Initialize content repurposer\n",
    "repurposer = MultiPlatformContentRepurposer()\n",
    "print(\"✅ Multi-Platform Content Repurposer ready!\")"
   ]
  },
